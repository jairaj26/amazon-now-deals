# ==============================================================================
# Amazon Now (Tez) Deals Bot Configuration
# ==============================================================================

# Telegram Bot Credentials
# Get bot token from @BotFather, and chat ID from @userinfobot or channel ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Amazon Now Session & Store Configuration
# 1. Open DevTools (F12) -> Network on https://www.amazon.in/tez/browse/home
# 2. Copy the Cookie header from any /tez/browse request
AMAZON_COOKIE=

# Dark store brandId (from URL query 'brandId=...' or sessionStorage.__aznowBrandId)
AMAZON_BRAND_ID=

# Minimum discount threshold (deals with discount >= MIN_DISCOUNT are alerted)
MIN_DISCOUNT=70

# Concurrency & Performance
MAX_WORKERS=5
INTER_PAGE_DELAY=0.8

# Path to deduplication cache file
CACHE_FILE=data/posted_deals.json

# Set to true to test scraping without sending Telegram alerts
DRY_RUN=false

# Optional: Skin Care browse node ID once discovered
# SKIN_CARE_NODE_ID=
